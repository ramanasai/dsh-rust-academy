{
  "name": "@local/rust-academy",
  "version": "1.0.0",
  "private": true,
  "description": "A Rust learning studio in the Harness sidebar: 20 lessons, exercises, and a syntax cheatsheet.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramanasai/dsh-rust-academy.git"
  },
  "homepage": "https://github.com/ramanasai/dsh-rust-academy#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "rust",
    "learning"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
