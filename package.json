{
  "name": "@local/rust-academy",
  "version": "3.1.0",
  "private": true,
  "description": "Industry-grade Rust curriculum in the Harness sidebar: six tracks from language fundamentals to web services, data, microservices, process handling, and production platform work.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramanasai/dsh-rust-academy.git"
  },
  "homepage": "https://github.com/ramanasai/dsh-rust-academy#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "rust",
    "axum",
    "tokio",
    "microservices",
    "learning"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "build.mjs",
    "src/**",
    "scripts/**"
  ],
  "scripts": {
    "build": "node build.mjs",
    "validate": "node scripts/validate-data.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
